# ── Database ────────────────────────────────────────────────────────────────
# Runtime URL (app connects via @prisma/adapter-pg).
#   Local dev:  start the bundled dev DB with `pnpm exec prisma dev -d --name glassbox`,
#               then copy its plain TCP url (printed on start / `prisma dev ls`).
#   Production: Neon POOLED connection string (the -pooler host).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# CLI/migrations URL.
#   Local dev:  the prisma+postgres:// url from `prisma dev ls`.
#   Production: Neon DIRECT connection string (non-pooler host).
MIGRATE_DATABASE_URL=""

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Optional Google OAuth:
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── Model provider (set ONE; Anthropic-direct wins when both are set) ──────
ANTHROPIC_API_KEY=""
# OPENROUTER_API_KEY=""
# AGENT_PROVIDER=anthropic   # or: openrouter (forces a provider)

# ── Storage & execution ────────────────────────────────────────────────────
# disk (default) stores dataset files under DATA_DIR; s3 driver lands later.
STORAGE_DRIVER=disk
DATA_DIR=.data
# Max concurrent Python kernels (one per active conversation; ~300-700MB RSS each).
MAX_KERNELS=4
