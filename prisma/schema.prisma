// Glass Box SaaS — multi-tenant schema.
// Runtime connects via @prisma/adapter-pg (works for local `prisma dev` and Neon).
// For Neon: DATABASE_URL = pooled (-pooler) host; migrations use the direct host
// (configured in prisma.config.ts at deploy time).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// Reused as the per-version status (name kept to minimize churn; v3 §2).
enum DatasetStatus {
  PROCESSING
  NEEDS_SHEET_PICK
  READY
  ERROR
}

// A Source is tabular (CSV/Excel) or a document (PDF/DOCX/TXT) — v3 §2.
enum SourceKind {
  TABULAR
  DOCUMENT
}

enum MessageRole {
  USER
  ASSISTANT
}

enum RunStatus {
  RUNNING
  DONE
  ERROR
  CANCELLED
}

// The user's function in an org — drives persona-aware framing (v3 §3).
enum Persona {
  SALES
  SUPPORT
  FINANCE
  OPERATIONS
  CONSULTANT
}

// User-selectable analysis depth, mapped to Claude's effort (v3 §16.4).
enum AnalysisEffort {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String? // null = OAuth-only account
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  memberships   Membership[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Auth.js OAuth account linking (Google)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  retentionDays Int? // null = keep until user deletes
  domain        String? // "B2B SaaS sales", "IT procurement" — workspace framing (v3 §3)
  vertical      String? // "Healthcare", "Fintech", … industry framing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   Membership[]
  invitations   Invitation[]
  sources       Source[]
  conversations Conversation[]
  reports       ReportSnapshot[]
  auditLogs     AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(MEMBER)
  persona   Persona? // functional role for persona-aware framing (v3 §3)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        Role      @default(MEMBER)
  token       String    @unique @default(cuid())
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([email])
}

// The logical artifact ("Q3 Vendor RFP", "sales_prospects") — v3 §2.
// Has many versions (v1, v2…); conversations pin a specific version.
model Source {
  id        String     @id @default(cuid())
  orgId     String
  kind      SourceKind @default(TABULAR)
  name      String
  domain    String? // optional per-source override of org domain/vertical
  vertical  String?
  createdAt DateTime   @default(now())

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions    SourceVersion[]
  links       ConversationSource[]
  comparisons Comparison[]

  @@index([orgId, kind])
}

// One uploaded revision of a Source. Absorbs today's Dataset fields (v3 §2).
model SourceVersion {
  id                 String        @id @default(cuid())
  sourceId           String
  version            Int // 1..n, monotonic per source
  uploadedById       String? // survives user deletion
  originalFilename   String
  mimeType           String
  sizeBytes          BigInt
  storageKey         String // normalized CSV artifact (canonical)
  originalStorageKey String? // raw upload, purgeable independently
  sheetName          String? // Excel source sheet, if applicable
  availableSheets    Json? // sheet names when NEEDS_SHEET_PICK
  rowCount           Int?
  columnSchema       Json? // ColumnSchema[]
  sampleRows         Json? // first 20 rows (what the LLM sees)
  sampled            Boolean       @default(false) // strided-sample flag
  normalizations     Json? // applied cleanups, shown in UI
  extractedTextKey   String? // document sources: storage key for extracted text/sections (v3 §14.1)
  profile            Json? // ColumnProfile[]+DatasetDomain (tabular) OR DocProfile (document) — source intelligence (v3 §4/§14.4)
  status             DatasetStatus @default(PROCESSING)
  errorMessage       String?
  deletedAt          DateTime? // soft delete
  purgeAt            DateTime? // scheduled hard delete (retention)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  source            Source               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  conversationLinks ConversationSource[]

  @@unique([sourceId, version])
  @@index([status, deletedAt])
  @@index([purgeAt])
}

// Conversations attach a Source and PIN a version (defaults to latest). v3 §2.
model ConversationSource {
  conversationId String
  sourceId       String
  versionId      String // the pinned SourceVersion
  alias          String // python variable name (tabular) / doc handle

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  source       Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version      SourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([conversationId, sourceId])
  @@unique([conversationId, alias])
}

// Cached diff between two versions of a source (v3 §15).
model Comparison {
  id          String   @id @default(cuid())
  sourceId    String
  fromVersion Int
  toVersion   Int
  summary     Json // structured diff + Claude "what materially changed"
  createdAt   DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, fromVersion, toVersion])
}

model Conversation {
  id          String   @id @default(cuid())
  orgId            String
  createdById      String?
  title            String
  starterQuestions Json? // cached persona×data starter questions (v3 §5)
  defaultEffort    AnalysisEffort @default(LOW) // analysis-depth dial (v3 §16.4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org      Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sources  ConversationSource[]
  messages Message[]
  reports  ReportSnapshot[]

  @@index([orgId, updatedAt(sort: Desc)])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String?     @db.Text // user question text
  events         Json? // AgentEvent[] — feed replay (assistant runs)
  apiMessages    Json? // ChatMessage[] appended this turn — LLM context
  report         Json? // FinalReport, if produced
  suggestions    Json? // follow-up question chips for this assistant turn (v3 §5)
  effort         AnalysisEffort? // effort this run used (v3 §16.4)
  intent         String? // classified intent: quick_fact|analytical|decision (v3 §6)
  modality       String? // "tabular"|"document" — which worker ran (mixed-convo history scoping)
  inputTokens    Int         @default(0)
  outputTokens   Int         @default(0)
  status         RunStatus   @default(DONE)
  error          String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ReportSnapshot {
  id             String    @id @default(cuid())
  orgId          String
  conversationId String
  messageId      String?
  title          String
  report         Json // FinalReport
  charts         Json // ChartSpec[]
  shareToken     String?   @unique // nanoid(32); null = private
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  orgId      String
  actorId    String? // null = system (retention cron)
  action     String // "dataset.upload", "dataset.hard_delete", ...
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, action])
}
