# Glass Box — production compose config. Copy to .env and fill in.
#   cp .env.production.example .env
# .env is git-ignored. Compose reads it for ${VAR} substitution (db, cloudflared)
# AND injects it into the app/migrate containers via env_file.
#
# NOTE: env_file values are LITERAL — no ${...} expansion inside this file.
# Write the real password into DATABASE_URL by hand (must match POSTGRES_PASSWORD).

# ── Postgres (db service) ───────────────────────────────────────────────────
# User/db are fixed to "glassbox" in docker-compose.yml; only the password here.
POSTGRES_PASSWORD=change-me-strong-password

# ── Database URL (app + migrate) ────────────────────────────────────────────
# Host is the compose service name `db`. Password must equal POSTGRES_PASSWORD.
DATABASE_URL=postgresql://glassbox:change-me-strong-password@db:5432/glassbox
# Prisma CLI (migrations) — same target locally; falls back to DATABASE_URL.
MIGRATE_DATABASE_URL=postgresql://glassbox:change-me-strong-password@db:5432/glassbox

# ── Auth (Auth.js v5) ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-base64-32-bytes
AUTH_TRUST_HOST=true
# Public origin the app is served on. With the default quick tunnel this is the
# *.trycloudflare.com URL cloudflared prints — set it AFTER `up` (see DEPLOY.md),
# then restart the app. With a named tunnel, use your fixed hostname.
AUTH_URL=https://REPLACE-WITH-TUNNEL-URL.trycloudflare.com

# ── Model provider (set ONE; Anthropic-direct wins when both are set) ───────
OPENROUTER_API_KEY=sk-or-...
AGENT_PROVIDER=openrouter
# ANTHROPIC_API_KEY=

# ── Storage & execution ─────────────────────────────────────────────────────
STORAGE_DRIVER=disk
DATA_DIR=/data
# Pyodide kernels are ~300-700MB RAM each (one per active conversation).
# Size to the RAM headroom on this shared host — see `free -h`.
MAX_KERNELS=2

# ── Cloudflare Tunnel (cloudflared service) ─────────────────────────────────
# NOT needed for the default quick tunnel (no account/token). Only set this if
# you switch docker-compose.yml's cloudflared service to the named-tunnel form
# for a stable hostname — it's the connector token whose public hostname routes
# to http://app:3000 (configured in the Cloudflare Zero Trust dashboard).
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# Platform operators (super-admins): comma-separated emails that can see the
# global marketing leads inbox at /app/admin/leads. NOT the same as a workspace
# OWNER/ADMIN. Leave blank to disable the leads inbox entirely.
PLATFORM_ADMIN_EMAILS=
