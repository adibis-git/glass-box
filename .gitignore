# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Large uploaded datasets — keep out of the repo (upload via the UI instead).
# The bundled demo samples are kept.
/public/samples/*
!/public/samples/indian_startup_funding.csv
!/public/samples/ecommerce_sales.csv
!/public/samples/employee_attrition.csv
!/public/samples/sales_team.csv
!/public/samples/sales_prospects.csv
!/public/samples/sales_meetings.csv

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# runtime data, caches, and temp fixtures — never commit
/.data
/.pyodide-cache
/.tmp-fixtures
